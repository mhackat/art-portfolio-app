# --- Database ---
# Local: run Postgres via Docker (see README) or point at Neon/Supabase dev branch
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/art_portfolio?schema=public"

# --- Auth (next-auth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Image storage (S3-compatible; Cloudflare R2 recommended) ---
# See README "Image uploads" for how to get these from R2 or AWS S3.
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_PUBLIC_URL_BASE=

# --- Admin access ---
# Comma-separated list of user emails allowed to use /admin.
# ADMIN_EMAILS=

# --- Environment label (used in Swagger UI + logging) ---
APP_ENV="local"

# --- Rate limits ---
# Login and signup are throttled per identifier over a 15-minute window.
# Production uses tight numbers (10 logins, 5 signups); everywhere else gets
# relaxed ones (200 / 100) so an automated suite isn't throttled by defaults
# meant to slow credential stuffing.
#
# "Production" means VERCEL_ENV=production, or APP_ENV=production for a deploy
# that isn't on Vercel. Set these to override either default explicitly.
# RATE_LIMIT_LOGIN_MAX=
# RATE_LIMIT_SIGNUP_MAX=

# --- Signup access codes ---
# Signup is invite-only: it needs a single-use code minted by an admin.
#
# Set to "false" to suspend that requirement, so anyone can register. Intended
# only for an environment whose database has been reset and therefore has no
# admin to mint the first code — remove it again once one exists.
#
# Production ignores this entirely and always requires a code, so it cannot be
# switched off on the live site by a stray value.
#
# Note: while suspended, the API suite's "signup is closed without a code"
# assertion will fail, so the deploy gate goes red until it is removed.
# SIGNUP_ACCESS_CODE_REQUIRED=false
